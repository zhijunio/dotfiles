# AI CLI wrappers
function codex() {
  command codex --dangerously-bypass-approvals-and-sandbox "$@"
}

function claude() {
  command claude --dangerously-skip-permissions "$@"
}

# Yazi 文件管理器
function y() {
    local cwd_file cwd
    cwd_file=$(mktemp -t "yazi-cwd.XXXXXX")
    trap 'rm -f -- "$cwd_file"' RETURN

    yazi "$@" --cwd-file="$cwd_file"
    if cwd=$(cat -- "$cwd_file") && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        cd -- "$cwd"
    fi
}

# 快速创建文件
function touchd() {
    mkdir -p -- "$(dirname -- "$1")"
    touch -- "$1"
}

# Create directory and cd into it
function mkcd() {
  mkdir -p -- "$1" && cd -- "$1"
}

# Go to the root of the current git repository
function croot() {
    local root
    if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
        echo "Not in a git repository" >&2
        return 1
    fi

    cd -- "$root"
}

# Create a temporary directory and cd into it
function tmpcd() {
    local dir
    dir=$(mktemp -d -t "tmpcd.XXXXXX") || return 1
    cd -- "$dir"
}

# Extract various archive types
function extract() {
  if [[ -f $1 ]]; then
    case $1 in
      *.tar.bz2)   tar xjf "$1"     ;;
      *.tar.gz)    tar xzf "$1"     ;;
      *.bz2)       bunzip2 "$1"     ;;
      *.rar)       unrar x "$1"     ;;
      *.gz)        gunzip "$1"      ;;
      *.tar)       tar xf "$1"      ;;
      *.tbz2)      tar xjf "$1"     ;;
      *.tgz)       tar xzf "$1"     ;;
      *.zip)       unzip "$1"       ;;
      *.Z)         uncompress "$1"  ;;
      *.7z)        7z x "$1"        ;;
      *)           echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# 查找并进入目录
function cdf() {
    local target
    target=$(find . -type d -name "*$1*" -print -quit)
    if [[ -z "$target" ]]; then
        echo "No matching directory found: $1" >&2
        return 1
    fi

    cd -- "$target"
}

# 杀死占用端口的进程
function killport() {
    local force=false list=false port signal
    case "$1" in
        -l|--list)
            list=true
            shift
            ;;
        -9|--force)
            force=true
            shift
            ;;
    esac

    port="${1:-}"
    if [[ -z "$port" || ! "$port" =~ '^[0-9]+$' || "$port" -lt 1 || "$port" -gt 65535 ]]; then
        echo "Usage: killport [--list|-l] [--force|-9] <port_number>" >&2
        return 1
    fi

    if [[ "$list" == true ]]; then
        lsof -nP -iTCP:"$port" -sTCP:LISTEN
        return $?
    fi

    local -a pids
    pids=("${(@f)$(lsof -ti tcp:"$port" 2>/dev/null)}")
    if (( ${#pids[@]} == 0 )); then
        echo "No process found on port $port"
        return 1
    fi

    if [[ "$force" == true ]]; then
        signal="-9"
        echo "Force killing ${#pids[@]} process(es) on port $port: ${pids[*]}"
        kill "$signal" "${pids[@]}"
        return $?
    fi

    echo "Terminating ${#pids[@]} process(es) on port $port: ${pids[*]}"
    kill "${pids[@]}"
    sleep 1

    local -a remaining
    remaining=("${(@f)$(lsof -ti tcp:"$port" 2>/dev/null)}")
    if (( ${#remaining[@]} )); then
        echo "Still running after SIGTERM, force killing: ${remaining[*]}"
        kill -9 "${remaining[@]}"
    fi
}

# Show listening TCP ports with owning processes
function ports() {
    lsof -nP -iTCP -sTCP:LISTEN
}

# Docker shell helper
function dsh() {
    local container="${1:-}"
    local shell_bin="${2:-/bin/sh}"

    if [[ -z "$container" ]]; then
        echo "Usage: dsh <container> [shell]" >&2
        return 1
    fi

    docker exec -it "$container" "$shell_bin"
}

# Docker Cleanup Function
function clean_docker() {
  echo "Starting Docker cleanup..."

  # Remove stopped containers
  local -a containers images
  containers=("${(@f)$(docker ps -a -q)}")
  if (( ${#containers[@]} )); then
    echo "Removing containers: ${containers[*]}"
    docker rm -f "${containers[@]}"
  else
    echo "No containers to remove"
  fi

  # Remove dangling images
  images=("${(@f)$(docker images -a -q -f dangling=true)}")
  if (( ${#images[@]} )); then
    echo "Removing dangling images: ${images[*]}"
    docker rmi "${images[@]}"
  else
    echo "No dangling images to remove"
  fi

  # Clean networks
  echo "Cleaning unused networks..."
  docker network prune --force

  echo "Docker cleanup completed!"
}

function clean_idea() {
    echo "🧹 Cleaning IntelliJ IDEA..."

    rm -rf "/Applications/IntelliJ IDEA.app"
    rm -rf ~/Library/Application\ Support/JetBrains/
    rm -rf ~/Library/Preferences/com.apple.java.util.prefs.plist
    rm -rf ~/Library/Preferences/com.jetbrains*
    rm -rf ~/Library/Preferences/jetbrains*
    rm -rf ~/Library/Caches/JetBrains
    rm -rf ~/Library/Logs/JetBrains/
    rm -rf ~/Library/Saved\ Application\ State/com.jetbrains.intellij.savedState/
    rm -rf ~/.cache/JetBrains/
    rm -rf ~/.config/JetBrains/

    killall cfprefsd 2>/dev/null || true

    echo "✅ IntelliJ IDEA cleaned successfully"
}

# 清理构建产物
function clean_build() {
    local dry_run=false
    if [ "$1" = "-n" ] || [ "$1" = "--dry-run" ]; then
        dry_run=true
    fi

    if [ "$(pwd -P)" = "/" ]; then
        echo "cleanup: refuse to run at filesystem root" >&2
        return 1
    fi

    local dirs_to_clean="node_modules target build dist out .next __pycache__ .pytest_cache .mypy_cache .gradle .turbo coverage .nuxt venv .venv Pods"

    if [ "$dry_run" = true ]; then
        echo "cleanup: dry-run (won't delete):"
        for dir in $dirs_to_clean; do
            find . -type d -name "$dir" -prune -print 2>/dev/null | while read -r d; do
                [[ "$d" != */.git/* ]] && echo "$d"
            done
        done
        return 0
    fi

    for dir in $dirs_to_clean; do
        find . -type d -name "$dir" -prune -print 2>/dev/null | while read -r d; do
            [[ "$d" != */.git/* ]] && rm -rf "$d" 2>/dev/null
        done
    done

    find . -type f \( -name ".DS_Store" -o -name "*.log" \) -print 2>/dev/null | while read -r f; do
        [[ "$f" != */.git/* ]] && rm -f "$f" 2>/dev/null
    done

    echo "cleanup: done"
}

# 拉取代码
function pull_code() {
    local root
    if [ "$1" = "." ] || [ "$1" = "--here" ]; then
        root="$(pwd -P)"
        (cd "$root" && for dir in */; do [ -d "$dir/.git" ] && (cd "$dir" && git pull); done)
    else
        for root in "$HOME/github" "$HOME/work"; do
            [ -d "$root" ] && (cd "$root" && for dir in */; do [ -d "$dir/.git" ] && (cd "$dir" && git pull); done)
        done
    fi
}

# Fetch updates in the current git repository
function gfetch() {
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not in a git repository" >&2
    return 1
  fi

  git fetch --all --prune --tags
}

# -----------------------------------------------------------------------------
# Dotfiles workflow
# -----------------------------------------------------------------------------
function dotpush() {
  (cd ~/.dotfiles && git add -A && git commit -m "${1:-update}" && git push)
}
function dotpull() {
  (cd ~/.dotfiles && git pull)
}

# Git Push Function
function gpo() {
  local branch
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || return

  if [[ $# -eq 0 ]]; then
    git push origin "$branch"
  else
    git push "$@"
  fi
}

# Git Main Function - Switch to main/master and pull
function gmp() {
  # Check if we're in a git repository
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not in a git repository"
    return 1
  fi

  # Try to checkout main first, fall back to master
  if git show-ref --verify --quiet refs/heads/main; then
    echo "Switching to main branch..."
    git switch main
  elif git show-ref --verify --quiet refs/heads/master; then
    echo "Switching to master branch..."
    git switch master
  else
    echo "Error: Neither 'main' nor 'master' branch exists"
    return 1
  fi

  # Pull the latest changes
  echo "Pulling latest changes..."
  git pull
}

# Git Tag Push Function - Create and push CalVer tag from main branch
function gtp() {
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not in a git repository"
    return 1
  fi

  local current_branch
  current_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

  # Ensure we're on main/master
  if [[ "$current_branch" != "main" && "$current_branch" != "master" ]]; then
    echo "Error: Must be on main or master branch (currently on '$current_branch')"
    return 1
  fi

  # Pull latest changes
  echo "Pulling latest changes..."
  git pull || return 1

  # Generate CalVer tag: vYY.MM.N (incrementing N from latest tag in current month)
  local prefix
  prefix="v$(date +"%y.%m")"

  # Find the highest N in existing vYY.MM.N tags
  local last_num
  last_num=$(git tag -l "${prefix}.*" | sed "s/^${prefix}\.//" | sort -n | tail -1)

  local next_num
  if [[ -z "$last_num" ]]; then
    next_num=1
  else
    next_num=$((last_num + 1))
  fi

  local tag="${prefix}.${next_num}"

  echo "Creating tag: $tag"
  git tag "$tag" || return 1

  echo "Pushing tag to origin..."
  git push origin "$tag"
}
