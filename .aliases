# -----------------------------------------------------------------------------
# Listing
# -----------------------------------------------------------------------------
if command -v eza >/dev/null 2>&1; then
  alias ls='eza'
  alias ll='eza -alF'
  alias la='eza -a'
  alias l='eza -CF'
  alias tree='eza --tree'
else
  alias ll='ls -alF --color=auto'
  alias la='ls -A --color=auto'
  alias l='ls -CF --color=auto'
fi

# -----------------------------------------------------------------------------
# Process / system
# -----------------------------------------------------------------------------
if command -v btop >/dev/null 2>&1; then
  alias top='btop'
elif command -v htop >/dev/null 2>&1; then
  alias top='htop'
fi

# -----------------------------------------------------------------------------
# Navigation
# -----------------------------------------------------------------------------
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

# -----------------------------------------------------------------------------
# Git
# -----------------------------------------------------------------------------
alias g='git'

# Go to project root
alias grt='cd "$(git rev-parse --show-toplevel)"'

alias gs='git status'
alias gp='git push'
alias gpf='git push --force'
alias gpft='git push --follow-tags'
alias gpl='git pull --rebase'
alias gcl='git clone'
alias gst='git stash'
alias grm='git rm'
alias gmv='git mv'

alias main='git checkout main'

alias gco='git checkout'
alias gcob='git checkout -b'

alias gb='git branch'
alias gbd='git branch -d'

alias grb='git rebase'
alias grbom='git rebase origin/master'
alias grbc='git rebase --continue'

alias gl='git log'
alias glo='git log --oneline --graph'

alias grh='git reset HEAD'
alias grh1='git reset HEAD~1'

alias ga='git add'
alias gA='git add -A'

alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit -a'
alias gcam='git add -A && git commit -m'
alias gfrb='git fetch origin && git rebase origin/master'

alias gxn='git clean -dn'
alias gx='git clean -df'

alias gsha='git rev-parse HEAD | pbcopy'

alias ghci='gh run list -L 1'

# -----------------------------------------------------------------------------
# GitHub CLI
# -----------------------------------------------------------------------------
if command -v gh >/dev/null 2>&1; then
  alias pr='gh pr'
  alias prs='gh pr status'
  alias prv='gh pr view'
  alias prc='gh pr checkout'
  alias pri='gh pr create'
  alias gi='gh issue'
  alias gil='gh issue list'
  alias gic='gh issue create'
  alias repo='gh repo'
  alias rel='gh release'
  alias ghci='gh run list --limit 1'
  alias ghfork='gh repo fork --default-branch-only --remote'
fi

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
if command -v docker >/dev/null 2>&1; then
  alias d='docker'
  alias dps='docker ps'
  alias dpa='docker ps -a'
  alias di='docker images'
  alias dlog='docker logs'
  alias dexec='docker exec -it'
  alias dstop='docker stop'
  alias drm='docker rm'
fi

# -----------------------------------------------------------------------------
# Homebrew
# -----------------------------------------------------------------------------
if command -v brew >/dev/null 2>&1; then
  alias bi='brew install'
  alias bu='brew uninstall'
  alias bl='brew list'
  alias bs='brew search'
  alias bt='brew tap'
  alias bun='brew untap'
  alias bup='brew update && brew upgrade'
fi

# -----------------------------------------------------------------------------
# Text / date / editor
# -----------------------------------------------------------------------------
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

alias now='date +"%T"'
alias nowdate='date +"%d-%m-%Y"'
alias nowsec='date +"%s"'

alias python=python3
alias dot='cd ~/.dotfiles'
alias edit_env='vim ~/.env'
alias edit_m2='vim ~/.m2/settings.xml'
alias reload_shell='exec zsh -l'

# -----------------------------------------------------------------------------
# Runtime switching
# -----------------------------------------------------------------------------
alias j8='mise shell java@zulu-8'
alias j21='mise shell java@21'
alias j25='mise shell java@25'
